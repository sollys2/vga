set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY vga
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vga.sv
set_global_assignment -name SDC_FILE vga.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# DE0-Nano: CLOCK_50, KEY[0], KEY[1]
set_location_assignment PIN_R8  -to clk
set_location_assignment PIN_J15 -to rst_n
set_location_assignment PIN_E1  -to btn_n

# VGA qua header JP1 (xem bang Pin assignment trong README)
set_location_assignment PIN_D9  -to hsync
set_location_assignment PIN_E10 -to vsync
set_location_assignment PIN_A6  -to r
set_location_assignment PIN_E6  -to g
set_location_assignment PIN_E9  -to b
