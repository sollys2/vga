--synthesis_resources = lut 8 
SUBDESIGN decode_k8a
( 
	data[2..0]	:	input;
	eq[7..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	eq_node[7..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode119w[3..0]	: WIRE;
	w_anode137w[3..0]	: WIRE;
	w_anode148w[3..0]	: WIRE;
	w_anode159w[3..0]	: WIRE;
	w_anode170w[3..0]	: WIRE;
	w_anode181w[3..0]	: WIRE;
	w_anode192w[3..0]	: WIRE;
	w_anode203w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	eq[] = eq_node[];
	eq_node[7..0] = eq_wire[7..0];
	eq_wire[] = ( w_anode203w[3..3], w_anode192w[3..3], w_anode181w[3..3], w_anode170w[3..3], w_anode159w[3..3], w_anode148w[3..3], w_anode137w[3..3], w_anode119w[3..3]);
	w_anode119w[] = ( (w_anode119w[2..2] & (! data_wire[2..2])), (w_anode119w[1..1] & (! data_wire[1..1])), (w_anode119w[0..0] & (! data_wire[0..0])), B"1");
	w_anode137w[] = ( (w_anode137w[2..2] & (! data_wire[2..2])), (w_anode137w[1..1] & (! data_wire[1..1])), (w_anode137w[0..0] & data_wire[0..0]), B"1");
	w_anode148w[] = ( (w_anode148w[2..2] & (! data_wire[2..2])), (w_anode148w[1..1] & data_wire[1..1]), (w_anode148w[0..0] & (! data_wire[0..0])), B"1");
	w_anode159w[] = ( (w_anode159w[2..2] & (! data_wire[2..2])), (w_anode159w[1..1] & data_wire[1..1]), (w_anode159w[0..0] & data_wire[0..0]), B"1");
	w_anode170w[] = ( (w_anode170w[2..2] & data_wire[2..2]), (w_anode170w[1..1] & (! data_wire[1..1])), (w_anode170w[0..0] & (! data_wire[0..0])), B"1");
	w_anode181w[] = ( (w_anode181w[2..2] & data_wire[2..2]), (w_anode181w[1..1] & (! data_wire[1..1])), (w_anode181w[0..0] & data_wire[0..0]), B"1");
	w_anode192w[] = ( (w_anode192w[2..2] & data_wire[2..2]), (w_anode192w[1..1] & data_wire[1..1]), (w_anode192w[0..0] & (! data_wire[0..0])), B"1");
	w_anode203w[] = ( (w_anode203w[2..2] & data_wire[2..2]), (w_anode203w[1..1] & data_wire[1..1]), (w_anode203w[0..0] & data_wire[0..0]), B"1");
END;
